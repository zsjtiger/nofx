# Crux Environment Variables Template
# Copy this file to .env and modify the values as needed

# ===========================================
# Server Configuration
# ===========================================

# Backend API server port
CRUX_BACKEND_PORT=8080

# Frontend web interface port
CRUX_FRONTEND_PORT=3000

# Container timezone, read by docker-compose (default Asia/Shanghai)
# TZ=Asia/Shanghai

# Market data for US equities (optional server-wide fallback).
# The Alpaca paper exchange account can also carry these keys in the UI.
# Alpaca paper keys: https://app.alpaca.markets
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Note: A-share data uses a Tushare Pro token. Enter it in the cn_paper
# exchange configuration in the UI rather than here.

# Backend port when running from source (default 8080). Docker always listens
# on 8080 inside the container; change CRUX_BACKEND_PORT for the host port.
# API_SERVER_PORT=8080

# Browser origins allowed to call the API, comma-separated. Only needed when
# the web app is served from a different origin than the API. Docker serves
# /api through nginx on the same origin, so it is not needed there.
# CORS_ALLOWED_ORIGINS=https://crux.example.com

# Base URL of a Crawl4AI server used by intelligence analysis (POST /api/intel/run).
# Leave unset to disable it. Run one with: docker run -p 11235:11235 unclecode/crawl4ai
# CRAWL4AI_URL=http://127.0.0.1:11235

# Maximum tokens per AI response (default 2000 when running from source;
# Docker defaults to 8000).
# AI_MAX_TOKENS=2000

# Anonymous usage statistics (default true). Set to false to turn them off.
# EXPERIENCE_IMPROVEMENT=false

# ===========================================
# Authentication (Required)
# ===========================================

# JWT signing secret (any random string, at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-this-in-production

# ===========================================
# Encryption Keys (Required)
# ===========================================

# AES-256 data encryption key (Base64 encoded, 32 bytes)
# Used for encrypting sensitive data in database (API keys, secrets)
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# RSA private key for client-server encryption (PEM format)
# Used for end-to-end encryption of sensitive data from browser
# Generate with: openssl genrsa 2048
# Note: Replace newlines with \n for single-line format
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----

# ===========================================
# Security Options
# ===========================================

# Transport encryption for API keys (default: false)
# When enabled, browser uses Web Crypto API to encrypt API keys before sending
# Requires HTTPS or localhost to work
# Set to true for enhanced security (HTTPS required)
# Set to false for easier deployment (HTTP/IP access allowed)
TRANSPORT_ENCRYPTION=false

# ===========================================
# Database (SQLite by default)
# ===========================================

DB_TYPE=sqlite
DB_PATH=data/data.db

# To use PostgreSQL instead, comment out the two lines above and uncomment:
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=crux_user
# DB_PASSWORD=
# DB_NAME=crux
# DB_SSLMODE=disable
